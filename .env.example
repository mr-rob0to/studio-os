# Local development uses file-backed PGlite. Tests use isolated in-memory PGlite.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.pglite/studio-os
# Preview and production use Neon with DATABASE_DRIVER=neon. Keep this secret server-only.
DATABASE_URL=

# Select one provider explicitly. The mock is deterministic and needs no credentials.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=openai. Keep this secret server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
# Manual local modes: success, timeout, or malformed.
MOCK_AI_MODE=success
