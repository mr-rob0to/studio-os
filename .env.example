# Local development uses PGlite. Task 2 will activate database selection.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.pglite/studio-os
DATABASE_URL=

# Local development defaults to the deterministic mock provider. Task 3 will activate it.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
MOCK_AI_MODE=success
